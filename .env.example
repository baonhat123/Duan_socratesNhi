# ==============================================================================
# SOCRATES NHÍ v3.0 - CẤU HÌNH KẾT NỐI AI CHUẨN OPENAI-COMPATIBLE
# Dự án tham dự Hội thi Sáng tạo trẻ Quốc gia trong lĩnh vực Trí tuệ nhân tạo 2026 - Bảng A
#
# QUY TẮC AN TOÀN (Mục 8.1 & Mục 19.1 Đặc tả v3.0):
# 1. File .env THẬT chứa API Key chỉ nằm trên máy của đội, KHÔNG commit, KHÔNG nộp vào hồ sơ.
# 2. File .env.example này chỉ chứa tên 3 biến cấu hình mà KHÔNG có giá trị thật.
# 3. Để đổi nhà cung cấp AI (Provider) hoặc đổi Model: Chỉ cần sửa file .env, không sửa mã nguồn.
# ==============================================================================

# URL API của nhà cung cấp tương thích chuẩn OpenAI (ví dụ: https://api.openai.com/v1 hoặc proxy)
OPENAI_BASE_URL=

# Khóa API bí mật của nhà cung cấp AI
OPENAI_API_KEY=

# Mã mô hình LLM chính xác sử dụng cho trợ lý Socratic (ghi vào Prompt Log v1.0)
SOCRATES_MODEL=
